{
    "name": "contenir/contenir-commerce",
    "description": "Commerce domain for Contenir sites on contenir-db-model 2: orders and their lifecycle, artworks, GST-inclusive money, artist enquiries, the email log, and Stripe checkout and refunds.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "commerce",
        "orders",
        "stripe",
        "gst"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "docs": "https://github.com/contenir/contenir-commerce/tree/main/docs",
        "issues": "https://github.com/contenir/contenir-commerce/issues",
        "source": "https://github.com/contenir/contenir-commerce"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-db-model": "^2.0@RC",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "stripe/stripe-php": "^22.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "laminas/laminas-servicemanager": "^3.22 || ^4.0",
        "php-db/phpdb-sqlite": "^0.2.0 || 0.3.x-dev",
        "phpunit/phpunit": "^11.5.50"
    },
    "replace": {
        "contenir/commerce": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Commerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Commerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laminas": {
            "component": "Contenir\\Commerce",
            "config-provider": "Contenir\\Commerce\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
